# Copia este archivo a .env y pega las credenciales de tu proyecto Firebase.
# Firebase Console -> Configuracion del proyecto -> Tus apps -> Configuracion del SDK

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poner en "true" para apuntar a los emuladores locales (npm run emulators)
VITE_USE_EMULATORS=false

# Credenciales del SOCIO DUEÑO (las que creas al registrarte por primera vez en
# la app). El script de seed entra con ellas para sembrar locales y catálogo,
# porque las reglas exigen una cuenta con perfil para escribir. Solo se usan en
# `npm run seed`, nunca en la app.
SEED_EMAIL=
SEED_PASSWORD=
