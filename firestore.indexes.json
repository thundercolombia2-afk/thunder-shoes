{
  "indexes": [
    {
      "//": "Catálogo en vivo y códigos de ejemplo: products activos ordenados por nombre.",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "name", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Historial filtrado por tipo, más reciente primero.",
      "collectionGroup": "movements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "occurredAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Historial filtrado por local.",
      "collectionGroup": "movements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "storeId", "order": "ASCENDING" },
        { "fieldPath": "occurredAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Historial filtrado por referencia.",
      "collectionGroup": "movements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "productId", "order": "ASCENDING" },
        { "fieldPath": "occurredAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Exportación por rango de días (dayKey) ordenada por fecha.",
      "collectionGroup": "movements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "dayKey", "order": "DESCENDING" },
        { "fieldPath": "occurredAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "//": "Alertas de stock bajo con collectionGroup('variants').where('stock','<='). Requiere el índice de 'stock' con alcance de grupo de colección.",
      "collectionGroup": "variants",
      "fieldPath": "stock",
      "indexes": [
        { "queryScope": "COLLECTION", "order": "ASCENDING" },
        { "queryScope": "COLLECTION_GROUP", "order": "ASCENDING" }
      ]
    }
  ]
}
