rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Reglas de seguridad de Thunder POS.
//
// Modelo: cada persona inicia sesión (correo + contraseña). El ROL vive en
// users/{uid} y lo leen las reglas — nunca se confía en lo que diga el cliente.
//
// Lo que garantizan estas reglas:
//  · Solo cuentas con perfil operan (crear/leer catálogo, movimientos, etc.).
//  · El libro mayor de movimientos es INMUTABLE y queda firmado con el uid real.
//  · Un empleado NO puede ascenderse a socio: registrarse exige una invitación
//    cuyo rol lo fijó un socio, y el rol del perfil debe coincidir con esa
//    invitación. Solo un socio puede crear invitaciones.
//
// Nota honesta sobre costos: el costo vive dentro del documento del producto.
// La app lo OCULTA a los empleados en la interfaz, pero una regla no puede
// ocultar un campo suelto: un empleado con conocimientos técnicos podría leerlo
// inspeccionando la app. Para ocultarlo de verdad hay que moverlo a una
// colección aparte legible solo por socios y calcular la utilidad en el
// servidor (Cloud Functions, plan Blaze). Ver README.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid()));
    }
    function isSocio() {
      return hasProfile()
        && get(/databases/$(database)/documents/users/$(uid())).data.role == 'socio';
    }
    // La DUEÑA: la primera cuenta. Solo ella ve/gestiona Configuración (para que
    // no se filtre la contraseña) y puede editar los perfiles del equipo.
    function isOwner() {
      return hasProfile()
        && get(/databases/$(database)/documents/users/$(uid())).data.get('owner', false) == true;
    }

    // ── Centinela de arranque ─────────────────────────────────────────────────
    // Lectura pública: solo dice si ya hay dueño, sin datos sensibles. Así la
    // pantalla de registro sabe (sin sesión) si mostrar el campo de invitación.
    match /system/state {
      allow get: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/state);
      allow update, delete: if false;
    }

    // ── Personas ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn();

      // Crear tu propio perfil: o eres el arranque (primer socio) o traes una
      // invitación válida cuyo rol coincide con el que te asignas.
      allow create: if uid() == userId
        && request.resource.data.role in ['socio', 'empleado', 'bodeguero']
        && (
          isBootstrapCreate()
          || (hasValidInvite(request.resource.data)
              && request.resource.data.get('owner', false) == false)
        );

      // Actualización:
      //  · la DUEÑA edita rol/local/bodegas/nombre de CUALQUIERA (no el correo,
      //    la fecha ni la marca de dueña);
      //  · cualquier otra persona solo edita su propio NOMBRE (nada de rol,
      //    local, bodegas o dueña) — así nadie se autoasciende ni se reasigna.
      allow update: if
        (isOwner()
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('owner', false) == resource.data.get('owner', false))
        || (uid() == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('storeId', '') == resource.data.get('storeId', '')
          && request.resource.data.get('bodegaIds', []) == resource.data.get('bodegaIds', [])
          && request.resource.data.get('owner', false) == resource.data.get('owner', false)
          && request.resource.data.get('active', true) == resource.data.get('active', true)
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt)
        // La dueña REAL del arranque (la de system/state) puede editar su propio
        // perfil sin restricción: sirve para "sanar" la marca de dueña en cuentas
        // creadas antes de que existiera.
        || (uid() == userId
          && exists(/databases/$(database)/documents/system/state)
          && get(/databases/$(database)/documents/system/state).data.get('ownerUid', '') == uid());

      allow delete: if false;
    }

    function isBootstrapCreate() {
      return request.resource.data.role == 'socio'
        && !exists(/databases/$(database)/documents/system/state);
    }
    function hasValidInvite(data) {
      return 'inviteCode' in data
        && exists(/databases/$(database)/documents/invites/$(data.inviteCode))
        && get(/databases/$(database)/documents/invites/$(data.inviteCode)).data.active == true
        && get(/databases/$(database)/documents/invites/$(data.inviteCode)).data.role == data.role;
    }

    // ── Invitaciones ──────────────────────────────────────────────────────────
    match /invites/{code} {
      allow read: if signedIn();

      // Solo la DUEÑA genera invitaciones, y solo activas y a su nombre.
      allow create: if isOwner()
        && request.resource.data.role in ['socio', 'empleado', 'bodeguero']
        && request.resource.data.active == true
        && request.resource.data.createdBy == uid();

      // Consumir: pasar de activa a usada, marcándose uno mismo, sin cambiar rol.
      allow update: if signedIn()
        && resource.data.active == true
        && request.resource.data.active == false
        && request.resource.data.usedBy == uid()
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ── Configuración global (contraseña de ingreso) ──────────────────────────
    // Lectura para operar (verificar la contraseña); escritura solo la dueña.
    match /system/config {
      allow read: if hasProfile();
      allow write: if isOwner();
    }

    // ── Bodegas: las administra la dueña; cualquiera con perfil las lee ────────
    match /bodegas/{bodegaId} {
      allow read: if hasProfile();
      allow write: if isOwner();
    }

    // ── Catálogo, locales y agregados: cualquier persona con perfil opera ──────
    // Los locales se LEEN sin sesión: el registro muestra la lista para que la
    // persona elija el suyo (aún no tiene cuenta). No hay dato sensible en un
    // código y nombre de local. Escribir sí exige perfil.
    match /stores/{storeId} {
      allow read: if true;
      allow write: if hasProfile();
    }
    match /products/{productId} {
      allow read: if hasProfile();
      allow create: if hasProfile();
      // Editar o eliminar una referencia: solo socios (incluye la dueña).
      allow update, delete: if isSocio();
      match /variants/{size} {
        allow read, write: if hasProfile();
      }
    }
    // El inventario en vivo y las alertas leen las tallas con una CONSULTA DE
    // GRUPO DE COLECCIÓN (collectionGroup('variants')). Firestore exige una regla
    // en forma `{path=**}/variants/{...}` para permitirla; sin esto la consulta
    // se rechaza y el catálogo nunca carga.
    match /{path=**}/variants/{variantId} {
      allow read: if hasProfile();
    }
    match /barcodes/{barcode} {
      allow read, write: if hasProfile();
    }
    match /dailyStats/{dayKey} {
      allow read, write: if hasProfile();
    }

    // ── Egresos: gastos cargados a mano por el administrador (socio/dueña) ─────
    // Cualquiera con perfil los lee (alimentan Ingresos y egresos); crearlos es
    // solo de socios y firmado con el uid real. No se editan; los borra la dueña.
    match /expenses/{expenseId} {
      allow read: if hasProfile();
      allow create: if isSocio()
        && request.resource.data.userId == uid()
        && request.resource.data.value is number
        && request.resource.data.quantity is int;
      // Editar/eliminar: cualquier socio (los egresos son un libro que administra
      // el negocio). No se puede cambiar quién lo registró ni cuándo.
      allow update: if isSocio()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.value is number
        && request.resource.data.quantity is int;
      allow delete: if isSocio();
    }

    // ── Libro mayor (INMUTABLE, firmado por el uid real) ──────────────────────
    match /movements/{movementId} {
      allow read: if hasProfile();
      allow create: if hasProfile()
        && request.resource.data.userId == uid()
        && isValidMovement(request.resource.data);
      // El libro mayor no se EDITA nunca. Borrarlo solo lo puede hacer la DUEÑA
      // (vaciar historial para empezar limpio); ningún empleado ni socio normal.
      allow update: if false;
      allow delete: if isOwner();
    }

    function isValidMovement(m) {
      return m.type in ['sale', 'purchase', 'return', 'salida', 'retorno', 'baja']
        && m.quantity is int && m.quantity >= 1
        && m.productId is string
        && m.variantId is string
        && m.storeId is string
        && m.userId is string
        && m.total is number
        && m.stockAfter is int
        && m.dayKey is string
        && m.occurredAt is timestamp;
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
